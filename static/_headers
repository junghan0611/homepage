# Response headers, read by Netlify and Cloudflare Workers static assets alike.
# When overlapping rules set the same header name, Cloudflare joins the values (Netlify keeps
# the later one), so a header name must live in only one of any two overlapping rules. Cache-Control is
# therefore set only on the specific rules; the generic Eval rules rely on the platform
# default (public, max-age=0, must-revalidate). Contract: docs/deploy-cloudflare.md.

/eval/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-hashes' 'sha256-ZzT+F1TC4hRMjYkMSNZ/GeRWBiHOjeioWsdWcYKFllg='; font-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()

